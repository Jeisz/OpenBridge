# Copia este archivo como .env y completa los valores.
# .env NUNCA se sube al repo (está en .gitignore).
# Si tu parte necesita una variable nueva, agrégala en su sección, en el mismo PR.

# --- Compartido ---
# Conexión a PostgreSQL. Se completa cuando exista el docker-compose.
DATABASE_URL=

# --- Ingesta ---
# Token de GitHub. Sin token, GitHub permite 60 peticiones por hora.
GITHUB_TOKEN=

# --- IA ---
# Proveedor del modelo de lenguaje: gemini (por defecto), groq-low, groq, claude-haiku u ollama.
AI_LLM_PROVIDER=
# Respaldos en orden si el principal falla por algo temporal; uno sin clave se omite; vacío = sin respaldo.
AI_LLM_FALLBACK=groq-low,claude-haiku
# Claves de los proveedores por API. Ollama corre en la máquina y no usa clave.
# Gemini: Google AI Studio (aistudio.google.com) -> Get API key.
GEMINI_API_KEY=
# Groq: console.groq.com -> API Keys.
GROQ_API_KEY=
# Anthropic (Claude, de pago): console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Orígenes que pueden llamar al servicio del asistente (CORS), separados por comas.
AI_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Conexión de la IA a PostgreSQL con el usuario openbridge_ai_writer (lee la vista, escribe en el esquema ai).
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:5432/postgres?sslmode=require
AI_DATABASE_URL=

# Conexión de solo lectura con openbridge_ai_reader (lee la vista y lo publicado por la IA en ai.*).
# Si una contraseña tiene símbolos (? " < > [ @ : / # ...), se debe codificar la URL (percent-encoding).
AI_READER_DATABASE_URL=
# De dónde lee el catálogo el servicio del asistente al arrancar: database (lo publicado; por defecto)
# o files (ai/data/catalog/). Si la base falla, usa los archivos y GET /health lo dice.
AI_CATALOG_SOURCE=
